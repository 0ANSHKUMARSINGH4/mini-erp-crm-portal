{
	"info": {
		"_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
		"name": "Mini ERP + CRM Operations Portal API",
		"description": "Complete Postman collection for Mini ERP + CRM Operations Portal covering Auth, Customer CRM, Product Inventory, Stock Movements, and Sales Challans.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:5000/api",
			"type": "string"
		},
		{
			"key": "authToken",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Module 1 - Auth",
			"item": [
				{
					"name": "Login (Admin)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@minierp.com\",\n  \"password\": \"Admin@123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "login"]
						}
					}
				},
				{
					"name": "Login (Sales)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"sales@minierp.com\",\n  \"password\": \"Sales@123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "login"]
						}
					}
				},
				{
					"name": "Get Current User Profile",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{authToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/auth/me",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "me"]
						}
					}
				}
			]
		},
		{
			"name": "Module 2 - Customer CRM",
			"item": [
				{
					"name": "Get Customers (Paginated)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{authToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/customers?page=1&limit=10&search=",
							"host": ["{{baseUrl}}"],
							"path": ["customers"],
							"query": [
								{ "key": "page", "value": "1" },
								{ "key": "limit", "value": "10" },
								{ "key": "search", "value": "" }
							]
						}
					}
				},
				{
					"name": "Create Customer Lead",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{authToken}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Vikram Shah\",\n  \"mobile\": \"+919876500011\",\n  \"email\": \"vikram@shahdistributors.com\",\n  \"businessName\": \"Shah Distribution Services\",\n  \"gst\": \"27AAAAA1111A1Z1\",\n  \"customerType\": \"DISTRIBUTOR\",\n  \"address\": \"GIDC Industrial Estate, Ahmedabad\",\n  \"status\": \"LEAD\",\n  \"notes\": \"Inquired for bulk electronic hardware ordering\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/customers",
							"host": ["{{baseUrl}}"],
							"path": ["customers"]
						}
					}
				},
				{
					"name": "Add Follow-up Note",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{authToken}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"note\": \"Discussed pricing catalog and sample shipment delivery date.\",\n  \"followUpDate\": \"2026-08-15\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/customers/:id/follow-ups",
							"host": ["{{baseUrl}}"],
							"path": ["customers", ":id", "follow-ups"]
						}
					}
				}
			]
		},
		{
			"name": "Module 3 - Product & Inventory",
			"item": [
				{
					"name": "Get Products List",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{authToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/products?page=1&limit=10",
							"host": ["{{baseUrl}}"],
							"path": ["products"],
							"query": [
								{ "key": "page", "value": "1" },
								{ "key": "limit", "value": "10" }
							]
						}
					}
				},
				{
					"name": "Create Product SKU",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{authToken}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"4K Ultra HD Monitor 27inch\",\n  \"sku\": \"SKU-DISP-4004\",\n  \"category\": \"Displays\",\n  \"unitPrice\": 18999.00,\n  \"initialStock\": 15,\n  \"minStockAlert\": 5,\n  \"location\": \"Rack C-02\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/products",
							"host": ["{{baseUrl}}"],
							"path": ["products"]
						}
					}
				},
				{
					"name": "Log Stock Movement (IN/OUT)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{authToken}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"productId\": \"04f70079-0df5-4524-b659-eeacf32e3230\",\n  \"quantity\": 10,\n  \"type\": \"IN\",\n  \"reason\": \"Warehouse restock shipment #4002\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/stock-movements",
							"host": ["{{baseUrl}}"],
							"path": ["stock-movements"]
						}
					}
				}
			]
		},
		{
			"name": "Module 4 - Sales Challans",
			"item": [
				{
					"name": "Create Draft / Confirmed Sales Challan",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{authToken}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"customerId\": \"c1111111-1111-1111-1111-111111111111\",\n  \"status\": \"CONFIRMED\",\n  \"notes\": \"Standard dispatch\",\n  \"items\": [\n    {\n      \"productId\": \"04f70079-0df5-4524-b659-eeacf32e3230\",\n      \"quantity\": 2,\n      \"unitPrice\": 2499.00\n    }\n  ]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/challans",
							"host": ["{{baseUrl}}"],
							"path": ["challans"]
						}
					}
				},
				{
					"name": "Confirm Draft Sales Challan (Atomic Stock Deduction)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{authToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/challans/:id/confirm",
							"host": ["{{baseUrl}}"],
							"path": ["challans", ":id", "confirm"]
						}
					}
				},
				{
					"name": "Cancel Sales Challan (Stock Reversal)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{authToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/challans/:id/cancel",
							"host": ["{{baseUrl}}"],
							"path": ["challans", ":id", "cancel"]
						}
					}
				}
			]
		}
	]
}
